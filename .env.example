NODE_ENV=development
HOST=0.0.0.0
PORT=3001
APP_PORT=3001
PUBLIC_BASE_PATH=/
RELEASE_TAG=local
APP_TIMEZONE=Asia/Shanghai
SQLITE_PATH=./data/guoxue.db
WEB_DIST_PATH=./apps/web/dist
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
LOG_LEVEL=info
PAIPAN_SERVICE_URL=http://127.0.0.1:8080
PAIPAN_TIMEOUT_MS=8000
# 排盘引用有效期；页面刷新恢复及未来智能老师读取均使用同一个 paipan_ref
PAIPAN_CONTEXT_TTL_SECONDS=7200

# 外部业务入口；专业排盘已改为站内路由
INTERPRETATION_URL=https://gx.yipuwh.com/h6/pages/jiedu/chat?isShowPay=1
QUESTION_URL=https://gx.yipuwh.com/h6/pages/jiedu/chat?isShowPay=1
LEARNING_URL=https://gx.yipuwh.com/h6/pages/jiedu/chat?isShowPay=1

# Dify 可稍后接入；未配置时 Worker 使用稳定备用内容
DIFY_BASE_URL=
DIFY_API_KEY=
DIFY_USER=daily-guidance-worker
DIFY_TIMEOUT_MS=60000
