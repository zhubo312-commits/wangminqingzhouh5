{
  "name": "@guoxue/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/guidance/worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "start:worker": "node dist/guidance/worker.js",
    "db:migrate": "tsx src/shared/database/migrate-cli.ts",
    "calendar:import": "tsx src/calendar/import-hko.ts",
    "guidance:generate": "tsx src/guidance/generate-cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@guoxue/contracts": "*",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.3",
    "node-cron": "^4.2.1",
    "pino": "^9.9.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
